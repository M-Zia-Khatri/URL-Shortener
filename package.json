{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter client --filter server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "ci": "biome ci . && pnpm test && pnpm build",
    "prepare": "husky",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "husky": "9.1.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "download"
    }
  }
}

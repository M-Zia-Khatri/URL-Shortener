DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379
PORT=3000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Security/cache/rate-limit hardening
BLOCK_PRIVATE_URLS=true
CACHE_TTL_SECONDS=3600
NEGATIVE_CACHE_TTL_SECONDS=30
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CREATE=20
RATE_LIMIT_MANAGEMENT=60
RATE_LIMIT_REDIRECT=120
RATE_LIMIT_ANALYTICS=120
